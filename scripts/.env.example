# arc-fuel deploy + runtime configuration. Copy to .env and fill in.

# --- roles ---
# Hardware-backed admin (Ledger Base account #1). Holds authority, not funds.
ADMIN=0x9dc649Ac43e36805F0C0AAEa1a91aB014b95339c
# Data-plane keys: generate fresh on deploy day (never reuse, never hardware).
RELAYER=
RELAYER_PK=
SIGNER=
SIGNER_PK=
# Throwaway deploy key — holds no power after deployment (admin is a
# constructor argument). Needs a little gas on each chain.
DEPLOYER_PK=

# --- chains ---
BASE_RPC=https://mainnet.base.org
# Arc mainnet: take RPC + chain id ONLY from docs.arc.io / circle.com /
# the ETHGlobal Arc sponsor page. Testnet (verified): https://rpc.testnet.arc.io  chainId 5042002
ARC_RPC=

# --- contracts ---
# wNEWS token on Base (canonical)
WNEWS=0xEd14e4978938aB2b474CdDa9213E3caa4EdD76bA
# filled after deploy:
BASE_LOCKER=
WNEWS_BRIDGE=
ATTESTED_PRICE=
START_BLOCK_BASE=
START_BLOCK_ARC=
